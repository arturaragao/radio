{
  "name": "bcbr-tiptap-vendor",
  "private": true,
  "description": "Gera vendor/tiptap.js (Tiptap/ProseMirror em um IIFE minificado). Uso: npm install && npm run build",
  "scripts": {
    "build": "esbuild entrada.js --bundle --minify --format=iife --target=chrome90 --legal-comments=none --outfile=../../vendor/tiptap.js"
  },
  "dependencies": {
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-blockquote": "3.33.0",
    "@tiptap/extension-bold": "3.33.0",
    "@tiptap/extension-details": "3.33.0",
    "@tiptap/extension-document": "3.33.0",
    "@tiptap/extension-heading": "3.33.0",
    "@tiptap/extension-horizontal-rule": "3.33.0",
    "@tiptap/extension-image": "3.33.0",
    "@tiptap/extension-italic": "3.33.0",
    "@tiptap/extension-link": "3.33.0",
    "@tiptap/extension-list": "3.33.0",
    "@tiptap/extension-paragraph": "3.33.0",
    "@tiptap/extension-strike": "3.33.0",
    "@tiptap/extension-text": "3.33.0",
    "@tiptap/extension-text-style": "3.33.0",
    "@tiptap/extension-underline": "3.33.0",
    "@tiptap/extensions": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/suggestion": "3.33.0",
    "esbuild": "0.28.2"
  }
}
